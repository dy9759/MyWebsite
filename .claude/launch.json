{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "dev",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "port": 3000,
            "autoPort": true
        },
        {
            "name": "dev-public",
            "runtimeExecutable": "env",
            "runtimeArgs": [
                "NEXT_PUBLIC_WIKI_API_URL=",
                "npm",
                "run",
                "dev",
                "--",
                "-p",
                "3001"
            ],
            "port": 3001
        },
        {
            "name": "wiki-chat",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "server/wiki-chat/server.js"
            ],
            "port": 8787
        }
    ]
}
