# AI Sense Wiki chat backend — environment. Copy to .env and fill in.
# The API key stays ONLY here (server side). Never commit .env or put the key
# in the frontend / static site.

# Bailian (阿里云百炼) Anthropic-compatible endpoint
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash-0731
# Keep the key only in this file (gitignored) / the deploy env. If a key is
# ever pasted into a chat, log, or commit, rotate it at the provider first.
ANTHROPIC_API_KEY=

# Server
PORT=8787
# Comma-separated allowed origins for CORS (the site's origin). "*" is dev-only.
# e.g. WIKI_ALLOWED_ORIGINS=https://lishengyuan.me,http://localhost:3000
WIKI_ALLOWED_ORIGINS=*
