# AI Sense Wiki chat backend — environment. Copy to .env and fill in.
# The API key stays ONLY here (server side). Never commit .env or put the key
# in the frontend / static site.

# Bailian (阿里云百炼) OpenAI-compatible endpoint (accepts workspace sk-ws-* keys)
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ANTHROPIC_MODEL=deepseek-v4-flash-0731
# Keep the key only in this file (gitignored) / the deploy env. If a key is
# ever pasted into a chat, log, or commit, rotate it at the provider first.
ANTHROPIC_API_KEY=

# Server
PORT=8787
# Comma-separated allowed origins for CORS (the site's origin). "*" is dev-only.
# e.g. WIKI_ALLOWED_ORIGINS=https://lishengyuan.me,http://localhost:3000
WIKI_ALLOWED_ORIGINS=*

# Public site origin used by the MCP search_wiki tool to read the search index.
WIKI_SITE_URL=http://localhost:3000

# Express "trust proxy": which proxies may set X-Forwarded-For. "loopback"
# (default) trusts only a reverse proxy on this host; use a hop count such as
# 1 behind a platform proxy, so rate limits key on the real client IP.
WIKI_TRUST_PROXY=loopback

# MCP endpoint guards. /sse and /messages share the per-IP limit with /chat.
# Optional shared secret — when set, MCP clients must send
# `Authorization: Bearer <token>`. Strongly recommended if the port is exposed.
WIKI_MCP_TOKEN=
# ask_wiki daily budget (counts against WIKI_DAILY_CAP too).
WIKI_MCP_DAILY_CAP=200
# Max concurrently open SSE sessions; idle sessions close after 30 min.
WIKI_MCP_MAX_SESSIONS=20
